{
  "expo": {
    "name": "RUTERO",
    "slug": "rutero-mobile",
    "scheme": "rutero",
    "version": "0.1.0",
    "icon": "./assets/rutero-logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0b0a09",
      "resizeMode": "contain",
      "image": "./assets/rutero-logo.png"
    },
    "android": {
      "package": "com.rutero.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/rutero-logo.png",
        "backgroundColor": "#0b0a09"
      },
      "permissions": []
    },
    "extra": {
      "apiBaseUrl": "https://vps71519.publiccloud.com.br"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
